{
  "name": "desktop-pet",
  "version": "0.2.0",
  "description": "바탕화면에 이미지가 떠다니는 데스크톱 앱",
  "main": "src/main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "make-sample-pet": "node scripts/make-sample-pet.js",
    "package:win": "electron-packager . desktop-pet --platform=win32 --arch=x64 --out=dist --overwrite --asar --ignore=\"^/dist\" --ignore=\"^/scripts\" --ignore=\"^/docs\""
  },
  "devDependencies": {
    "electron": "^36.0.0",
    "@electron/packager": "^20.3.0",
    "gifenc": "^1.0.3"
  }
}
